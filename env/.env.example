# Copy this file to `.env` and fill the values for local development.
# Do NOT commit your real `.env` file. Add `.env` to `.gitignore`.

# Supabase - Updated
SUPABASE_URL=https://qjwnudofsiznvfcgzwuv.supabase.co
SUPABASE_KEY=your_public_anon_key_here

# Google Sign-In (required for native mobile authentication)
# Get this from your Google Cloud Console OAuth 2.0 credentials
# For Android: This is the Web client ID (not the Android client ID)
# For iOS: This is also the Web client ID
GOOGLE_SERVER_CLIENT_ID=20991219787-oni5a1m6pg******vk3k7t0dvfuvp41.apps.googleusercontent.com
# Keep the Android client ID handy for Google Cloud Console configuration
GOOGLE_ANDROID_CLIENT_ID=20991219787-u5k5gmbumkb********smekv75hoth6uc28.apps.googleusercontent.com
# Set to true if you want to skip the native GoogleSignIn plugin and test via browser OAuth (useful on emulators)
FORCE_GOOGLE_WEB_OAUTH=false

# Stripe - Not updated
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# Carrier + Logistics (set if you want real Shippo/EasyPost rates)
SHIPPO_API_TOKEN=
